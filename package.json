{
  "name": "dsh-agent-mesh",
  "version": "0.1.0",
  "description": "Connect local coding CLIs to one DSH conversation with resumable sessions, handoffs, and bounded routing.",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "packageManager": "pnpm@11.19.0",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./core": {
      "default": "./src/index.js"
    },
    "./cli": {
      "default": "./bin/dsh-mesh.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-mesh": "./bin/dsh-mesh.js"
  },
  "files": [
    "src",
    "lib",
    "bin",
    "scripts",
    "DESIGN.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check src/runtime.js && node --check src/router.js && node --check src/dsh-plugin.js && node --check src/mesh-llm.js && node --check src/model-readiness.js && node --check src/client/index.js",
    "build": "node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test tests/*.test.js",
    "bench": "node bench/mesh.mjs",
    "pack:check": "node scripts/prepublish-check.mjs"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-model-selection": ">=0.1.0-rc.6"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "platform": "web"
    }
  },
  "license": "MIT"
}
